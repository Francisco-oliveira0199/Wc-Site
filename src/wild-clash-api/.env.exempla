# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=wildclash_db

# ============================================
# CONFIGURAÇÕES DE BACKUP
# ============================================
MAX_BACKUPS=10
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL=daily  # daily, weekly, monthly

# ============================================
# UPLOAD PARA SERVIÇOS EXTERNOS (OPCIONAL)
# ============================================
BACKUP_UPLOAD_ENABLED=false
BACKUP_UPLOAD_SERVICE=google_drive  # google_drive, dropbox, s3
BACKUP_UPLOAD_API_KEY=sua_chave_api
BACKUP_UPLOAD_FOLDER_ID=id_da_pasta

# ============================================
# NOTIFICAÇÕES (OPCIONAL)
# ============================================
BACKUP_NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/...
BACKUP_NOTIFICATION_EMAIL=admin@wildclash.com

# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
PORT=3001
NODE_ENV=production
JWT_SECRET=sua_chave_secreta_aqui
CORS_ORIGIN=*