{
  "name": "wildclash-api",
  "version": "1.0.0",
  "description": "API de gerenciamento de códigos Wild Clash com sistema de backup automático",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"No tests specified\" && exit 0",
    "migrate": "node scripts/migrate.js",
    "keep-alive": "node scripts/keep-alive.js",
    "backup": "node scripts/backup.js",
    "backup:create": "node scripts/backup.js create",
    "backup:restore": "node scripts/backup.js restore",
    "backup:list": "node scripts/backup.js list",
    "backup:schedule": "node scripts/backup.js schedule",
    "backup:cleanup": "node scripts/backup.js cleanup",
    "backup:upload": "node scripts/backup.js upload",
    "health": "node scripts/health-check.js",
    "logs": "tail -f logs/backup.log",
    "setup": "npm install && npm run migrate",
    "start:with-backup": "node scripts/backup.js schedule & node server.js"
  },
  "keywords": [
    "wildclash",
    "api",
    "codes",
    "backup",
    "mysql",
    "render",
    "uptimerobot"
  ],
  "author": "Wild Clash Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.0.0",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "winston": "^3.11.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/wildclash-api.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/wildclash-api/issues"
  },
  "homepage": "https://github.com/seu-usuario/wildclash-api#readme"
}