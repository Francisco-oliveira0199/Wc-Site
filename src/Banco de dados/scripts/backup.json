const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');
const util = require('util');
const execPromise = util.promisify(exec);
const db = require('../database');

class DatabaseBackup {
    constructor() {
        this.backupDir = path.join(__dirname, '../backups');
        this.maxBackups = 10;
        this.ensureBackupDirectory();
    }

    ensureBackupDirectory() {
        if (!fs.existsSync(this.backupDir)) {
            fs.mkdirSync(this.backupDir, { recursive: true });
        }
    }

    async createBackup() {
        const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
        const backupFile = path.join(this.backupDir, `backup-${timestamp}.sql`);
        
        console.log(` Criando backup: ${backupFile}`);

        try {
            // Exportar estrutura e dados
            const dumpCommand = `
                mysqldump \
                --host=${process.env.DB_HOST} \
                --port=${process.env.DB_PORT} \
                --user=${process.env.DB_USER} \
                --password=${process.env.DB_PASSWORD} \
                --single-transaction \
                --routines \
                --triggers \
                --events \
                ${process.env.DB_NAME} > ${backupFile}
            `;

            await execPromise(dumpCommand);
            
            // Compactar backup
            const gzipCommand = `gzip ${backupFile}`;
            await execPromise(gzipCommand);
            
            const compressedFile = `${backupFile}.gz`;
            const stats = fs.statSync(compressedFile);
            const fileSize = (stats.size / 1024 / 1024).toFixed(2);
            
            console.log(` Backup criado: ${compressedFile} (${fileSize} MB)`);
            
            // Limitar número de backups
            await this.cleanupOldBackups();
            
            return compressedFile;
        } catch (error) {
            console.error(` Erro ao criar backup: ${error.message}`);
            throw error;
        }
    }

    async cleanupOldBackups() {
        try {
            const files = fs.readdirSync(this.backupDir)
                .filter(file => file.endsWith('.sql.gz'))
                .map(file => ({
                    name: file,
                    path: path.join(this.backupDir, file),
                    time: fs.statSync(path.join(this.backupDir, file)).mtime.getTime()
                }))
                .sort((a, b) => b.time - a.time);

            // Manter apenas os backups mais recentes
            if (files.length > this.maxBackups) {
                const toDelete = files.slice(this.maxBackups);
                
                for (const file of toDelete) {
                    fs.unlinkSync(file.path);
                    console.log(` Backup antigo removido: ${file.name}`);
                }
            }
        } catch (error) {
            console.error(` Erro ao limpar backups: ${error.message}`);
        }
    }

    async restoreBackup(backupFile) {
        if (!backupFile) {
            // Encontrar o backup mais recente
            const files = fs.readdirSync(this.backupDir)
                .filter(file => file.endsWith('.sql.gz'))
                .sort()
                .reverse();
            
            if (files.length === 0) {
                throw new Error('Nenhum backup encontrado');
            }
            
            backupFile = path.join(this.backupDir, files[0]);
        }

        console.log(` Restaurando backup: ${backupFile}`);

        try {
            // Descompactar
            const gzipCommand = `gzip -d ${backupFile}`;
            await execPromise(gzipCommand);
            
            const sqlFile = backupFile.replace('.gz', '');
            
            // Restaurar banco
            const restoreCommand = `
                mysql \
                --host=${process.env.DB_HOST} \
                --port=${process.env.DB_PORT} \
                --user=${process.env.DB_USER} \
                --password=${process.env.DB_PASSWORD} \
                ${process.env.DB_NAME} < ${sqlFile}
            `;

            await execPromise(restoreCommand);
            
            // Remover arquivo descompactado
            fs.unlinkSync(sqlFile);
            
            console.log(' Backup restaurado com sucesso!');
        } catch (error) {
            console.error(` Erro ao restaurar backup: ${error.message}`);
            throw error;
        }
    }

    async scheduleBackups() {
        console.log(' Agendando backups automáticos...');
        
        // Executar backup a cada 24 horas
        setInterval(async () => {
            try {
                await this.createBackup();
            } catch (error) {
                console.error('Erro no backup agendado:', error);
            }
        }, 24 * 60 * 60 * 1000); // 24 horas
        
        // Executar primeiro backup imediatamente
        await this.createBackup();
    }
}

// Executar se chamado diretamente
if (require.main === module) {
    const args = process.argv.slice(2);
    const backup = new DatabaseBackup();
    
    if (args[0] === 'restore') {
        backup.restoreBackup(args[1]).catch(console.error);
    } else if (args[0] === 'schedule') {
        backup.scheduleBackups().catch(console.error);
    } else {
        backup.createBackup().catch(console.error);
    }
}

module.exports = DatabaseBackup;